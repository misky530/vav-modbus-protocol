  {
    "id": "e600000000000002",
    "type": "template",
    "z": "tab_vav_slave",
    "name": "曲线页面 HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "plain",
    "template": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>变静压历史曲线</title>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"></script>\n<style>\n  body{font-family:system-ui,sans-serif;margin:0;background:#f5f7fa;color:#1f2937}\n  header{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:12px 16px;background:#fff;border-bottom:1px solid #e5e7eb}\n  h1{font-size:18px;margin:0}\n  .tag{padding:4px 10px;border-radius:999px;font-size:13px;font-weight:600}\n  .n{background:#dbeafe;color:#1d4ed8}.s{background:#ffedd5;color:#c2410c}\n  main{padding:12px;display:grid;gap:12px}\n  .card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:10px 12px}\n  .card h2{font-size:14px;margin:0 0 8px;color:#4b5563}\n  canvas{width:100%;max-height:260px}\n  .muted{font-size:12px;color:#9ca3af}\n</style>\n</head>\n<body>\n<header>\n  <h1>变静压 · 历史曲线</h1>\n  <span id=\"mode\" class=\"tag n\">—</span>\n  <span class=\"muted\" id=\"meta\">加载中…</span>\n</header>\n<main>\n  <div class=\"card\"><h2>静压 / 房间压差 (Pa)</h2><canvas id=\"c1\"></canvas></div>\n  <div class=\"card\"><h2>风机频率 (Hz)</h2><canvas id=\"c2\"></canvas></div>\n  <div class=\"card\"><h2>阀1 风量 / 开度 / 模式</h2><canvas id=\"c3\"></canvas></div>\n  <div class=\"card\"><h2>排风阀总风量 (m³/h)</h2><canvas id=\"c4\"></canvas></div>\n</main>\n<script>\nconst opt = (yTitle)=>({\n  responsive:true, animation:false,\n  scales:{ x:{ type:'time' in Chart.defaults.scales ? undefined : undefined, ticks:{ maxTicksLimit:8, callback:(v,i,ticks)=>{ const t=ticks[i].raw||ticks[i].value; const d=new Date(typeof t==='number'?t:v); return d.toLocaleTimeString(); } } }, y:{ title:{display:!!yTitle,text:yTitle} } },\n  plugins:{ legend:{ position:'bottom' } }\n});\nfunction mk(id, datasets){\n  return new Chart(document.getElementById(id), { type:'line', data:{ labels:[], datasets }, options: opt() });\n}\nconst c1 = mk('c1', [\n  { label:'排风机-1 静压', data:[], borderColor:'#2563eb', tension:.2, pointRadius:0 },\n  { label:'排风机-2 静压', data:[], borderColor:'#f59e0b', tension:.2, pointRadius:0 },\n  { label:'房间压差', data:[], borderColor:'#059669', tension:.2, pointRadius:0 },\n]);\nconst c2 = mk('c2', [\n  { label:'排风机-1 频率', data:[], borderColor:'#2563eb', tension:.2, pointRadius:0 },\n  { label:'排风机-2 频率', data:[], borderColor:'#f59e0b', tension:.2, pointRadius:0 },\n]);\nconst c3 = mk('c3', [\n  { label:'阀1 风量', data:[], borderColor:'#2563eb', tension:.2, pointRadius:0 },\n  { label:'阀1 开度', data:[], borderColor:'#f59e0b', tension:.2, pointRadius:0 },\n  { label:'模式', data:[], borderColor:'#dc2626', tension:.0, pointRadius:0, stepped:true },\n]);\nconst c4 = mk('c4', [\n  { label:'阀1+2+3 总风量', data:[], borderColor:'#7c3aed', tension:.2, pointRadius:0 },\n  { label:'阀4+5+6 总风量', data:[], borderColor:'#0891b2', tension:.2, pointRadius:0 },\n]);\nfunction apply(ch, labels, arrs){\n  ch.data.labels = labels;\n  arrs.forEach((a,i)=> ch.data.datasets[i].data = a);\n  ch.update('none');\n}\nasync function tick(){\n  try{\n    const res = await fetch('/vav/api', {cache:'no-store'});\n    const j = await res.json();\n    const pts = j.points || [];\n    const labels = pts.map(p=>p.t);\n    apply(c1, labels, [pts.map(p=>p.pfyl1), pts.map(p=>p.pfyl2), pts.map(p=>p.yc)]);\n    apply(c2, labels, [pts.map(p=>p.fjpl1), pts.map(p=>p.fjpl2)]);\n    apply(c3, labels, [pts.map(p=>p.fl1), pts.map(p=>p.kd1), pts.map(p=>p.modeStatus)]);\n    apply(c4, labels, [pts.map(p=>p.fl_sum_123), pts.map(p=>p.fl_sum_456)]);\n    const el = document.getElementById('mode');\n    const standby = j.mode === 'standby';\n    el.textContent = standby ? '值班模式' : '正常模式';\n    el.className = 'tag ' + (standby ? 's' : 'n');\n    document.getElementById('meta').textContent = '点数 ' + pts.length + ' · 约保留 20 分钟 · 每秒刷新';\n  }catch(e){\n    document.getElementById('meta').textContent = '拉取失败: ' + e.message;\n  }\n}\ntick();\nsetInterval(tick, 1000);\n</script>\n</body>\n</html>\n",
