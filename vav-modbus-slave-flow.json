    "type": "function",
    "z": "tab_vav_slave",
    "name": "单点覆盖",
    "func": "const device = msg.device;\nconst code = msg.code;\nlet value = msg.payload;\nif (!device || !code || value === undefined || value === null) {\n  node.warn('需要 msg.device、msg.code、msg.payload');\n  return null;\n}\nvalue = Number(value);\nconst sim = global.get('vavSim') || { mode: 'normal', overrides: {}, t0: Date.now() };\nsim.overrides = sim.overrides || {};\nsim.overrides[device + '.' + code] = { value: value, until: Date.now() + 8000 };\nif (sim.fans && sim.fans[device]) sim.fans[device][code] = value;\nelse if (sim.valves && sim.valves[device]) sim.valves[device][code] = value;\nelse if (sim.room && sim.room[device]) sim.room[device][code] = value;\nglobal.set('vavSim', sim);\nmsg.payload = { fc: 3, unitid: 1, address: 0, quantity: 24 };\nmsg.topic = 'set/' + device + '.' + code;\nreturn msg;\n",
