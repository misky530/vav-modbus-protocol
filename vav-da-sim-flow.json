  {
    "id": "c100000000000080",
    "type": "function",
    "z": "tab_vav_sim",
    "name": "单点写入 global",
    "func": "// 单点写入示例：msg.device + msg.code + msg.payload(数值)\n// 例如 device='排风阀-1', code='kd', payload=75\nconst device = msg.device;\nconst code = msg.code;\nconst value = msg.payload;\nif (!device || !code || value === undefined || value === null) {\n  node.warn('需要 msg.device、msg.code、msg.payload');\n  return null;\n}\nconst sim = global.get('vavSim') || { mode: 'normal', fans: {}, valves: {}, room: {}, points: {} };\nconst key = device + '.' + code;\n\nif (sim.fans && sim.fans[device]) sim.fans[device][code] = value;\nelse if (sim.valves && sim.valves[device]) sim.valves[device][code] = value;\nelse if (sim.room && sim.room[device]) sim.room[device][code] = value;\n\nsim.points = sim.points || {};\nconst prev = sim.points[key] || { device, code, unit: '' };\nsim.points[key] = { device, code, value, unit: prev.unit || '' };\nglobal.set('vavSim', sim);\n\nmsg.payload = sim.points[key];\nmsg.topic = 'vavSim/set/' + key;\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 380,
    "wires": [
      [
        "c100000000000090"
      ]
    ]
