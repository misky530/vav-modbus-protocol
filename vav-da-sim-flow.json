    "id": "c100000000000050",
    "type": "function",
    "z": "tab_vav_sim",
    "name": "读取 global.vavSim.points",
    "func": "// 从 global 读出当前模拟测点\nconst sim = global.get('vavSim');\nif (!sim) {\n  msg.payload = { error: 'vavSim 尚未初始化，请先点「刷新模拟值」或切换模式' };\n  return msg;\n}\nmsg.payload = sim.points;\nmsg.mode = sim.mode;\nmsg.topic = 'vavSim/points';\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 300,
    "wires": [
