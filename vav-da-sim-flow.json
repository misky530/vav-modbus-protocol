  {
    "id": "c100000000000020",
    "type": "function",
    "z": "tab_vav_sim",
    "name": "写入 global.vavSim",
    "func": "// 变静压测点模拟：读写 global.vavSim，不连真实 Modbus\n// msg.mode = 'normal' | 'standby' 可切换；否则沿用已有模式\nconst prev = global.get('vavSim') || {};\nconst mode = (msg.mode || prev.mode || 'normal');\nconst normal = mode === 'normal';\n\n// 设计逻辑：阀开度≈80%不变；靠静压设定与风机频率改变风量\nconst sp = normal ? 500 : 300;          // Pa\nconst hz = normal ? 48 : 28;            // Hz（约值）\nconst fl = normal ? 2000 : 1000;        // m³/h（约值，对应 100%/50%）\nconst kd = 80;                          // %\n\nconst sim = {\n  mode,\n  sp,\n  fans: {\n    '排风机-1': { pfyl: sp, fjpl: hz },\n    '排风机-2': { pfyl: sp, fjpl: hz },\n  },\n  valves: {},\n  room: {\n    '温湿压-1': {\n      wd: (prev.room && prev.room['温湿压-1'] && prev.room['温湿压-1'].wd != null) ? prev.room['温湿压-1'].wd : 24,\n      sd: (prev.room && prev.room['温湿压-1'] && prev.room['温湿压-1'].sd != null) ? prev.room['温湿压-1'].sd : 55,\n      yc: (prev.room && prev.room['温湿压-1'] && prev.room['温湿压-1'].yc != null) ? prev.room['温湿压-1'].yc : 5,\n    }\n  },\n  // 扁平测点表，便于按 uniqueId / 设备名+code 读写\n  points: {}\n};\n\nfor (let i = 1; i <= 6; i++) {\n  const name = '排风阀-' + i;\n  sim.valves[name] = { fl, kd };\n}\n\n// 写入扁平 points\nfunction put(dev, code, value, unit) {\n  const key = dev + '.' + code;\n  sim.points[key] = { device: dev, code, value, unit };\n}\nput('排风机-1', 'pfyl', sim.fans['排风机-1'].pfyl, 'Pa');\nput('排风机-1', 'fjpl', sim.fans['排风机-1'].fjpl, 'Hz');\nput('排风机-2', 'pfyl', sim.fans['排风机-2'].pfyl, 'Pa');\nput('排风机-2', 'fjpl', sim.fans['排风机-2'].fjpl, 'Hz');\nfor (let i = 1; i <= 6; i++) {\n  const name = '排风阀-' + i;\n  put(name, 'fl', sim.valves[name].fl, 'm³/h');\n  put(name, 'kd', sim.valves[name].kd, '%');\n}\nput('温湿压-1', 'wd', sim.room['温湿压-1'].wd, '℃');\nput('温湿压-1', 'sd', sim.room['温湿压-1'].sd, '%');\nput('温湿压-1', 'yc', sim.room['温湿压-1'].yc, 'Pa');\n\nglobal.set('vavSim', sim);\nglobal.set('vavMode', mode);\n\nmsg.payload = sim;\nmsg.topic = 'vavSim/' + mode;\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 160,
    "wires": [
      [
        "c100000000000030"
      ]
    ]
  },
